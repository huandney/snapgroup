# O hook do snapg chega desligado (link para /dev/null em /etc, que toma o
# lugar do arquivo em /usr): instalar não muda quem faz os checkpoints do
# pacman. `snapg pacman on` troca o snap-pac pelo snapg; `off` desfaz.
OWN_HOOK_MASK=/etc/pacman.d/hooks/05-snapgroup-pre.hook

# Já rodou `snapg pacman on`: algum hook do snap-pac está desligado.
snap_pac_masked() {
    for hook in /etc/pacman.d/hooks/*snap-pac*.hook; do
        [ -L "$hook" ] && [ "$(readlink "$hook")" = /dev/null ] && return 0
    done
    return 1
}

# Decide pelo estado, não só pela versão: quem já escolheu o snapg (inclusive
# num build anterior com o mesmo número de versão) não perde os checkpoints.
# Limite: sem snap-pac, o `on` não deixa link nenhum para detectar, então um
# build de pré-release com `on` volta desligado no upgrade para a 0.13.0
# (rode `snapg pacman on` de novo). Quem vem da 0.12.0 publicada não tinha o
# hook e não é afetado.
mask_own_hook() {
    snap_pac_masked && return 0
    mkdir -p /etc/pacman.d/hooks
    [ -e "$OWN_HOOK_MASK" ] || [ -L "$OWN_HOOK_MASK" ] || ln -s /dev/null "$OWN_HOOK_MASK"
}

note_pacman_hook() {
    echo "==> O snapgroup pode fazer um checkpoint agrupado por transação do pacman,"
    echo "    no lugar do snap-pac. Para ligar: sudo snapg pacman on · voltar: sudo snapg pacman off"
}

post_install() {
    systemctl daemon-reload
    # Não habilita aqui — o `snapg redo` arma o serviço sob demanda.
    mask_own_hook
    note_pacman_hook
}

post_upgrade() {
    systemctl daemon-reload
    if [ "$(vercmp "$2" 0.13.0)" -lt 0 ] && ! snap_pac_masked; then
        mask_own_hook
        note_pacman_hook
    fi
}

pre_remove() {
    # Best-effort: se o serviço estiver armado (após um redo sem reboot),
    # desarma antes de remover o unit.
    systemctl disable snapg-cleanup.service 2>/dev/null || true
    # Sem o snapg, o snap-pac volta a fazer os checkpoints: some todo link para
    # /dev/null que o `snapg pacman on/off` possa ter deixado.
    for hook in "$OWN_HOOK_MASK" /etc/pacman.d/hooks/*snap-pac*.hook; do
        [ -L "$hook" ] && [ "$(readlink "$hook")" = /dev/null ] && rm -f "$hook"
    done
    return 0
}

post_remove() {
    systemctl daemon-reload
}
